# Copy this file to .env and fill in the API keys you use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=
GPT_4O_AZURE_OPENAI_API_VERSION=2024-05-13
GPT_4O_AZURE_OPENAI_DEPLOYMENT_NAME=
AUTOGEN_PROVIDER=openai
AUTOGEN_MODEL=gpt-4o-mini
# Optional role-specific models; blank or omitted values reuse AUTOGEN_MODEL.
AUTOGEN_WORKER_MODEL=
AUTOGEN_EVALUATOR_MODEL=
AUTOGEN_REQUEST_TIMEOUT=120
AUTOGEN_STREAM=true
AUTOGEN_STREAM_RETRIES=1
AUTOGEN_STREAM_FALLBACK=true
AUTOGEN_CODE_EXECUTOR=disabled
AUTOGEN_ENABLE_MATLAB=false
# Maximum time Chainlit waits for approval or clarification from the user.
CHAINLIT_ASK_TIMEOUT=600
OLLAMA_HOST=http://localhost:11434
# false streams final answers directly; true/low/medium/high enables reasoning.
OLLAMA_THINK=false
# Maximum generated tokens per Ollama agent response.
OLLAMA_NUM_PREDICT=2048
PASS_SCORE=8
LANGGRAPH_MAX_ITERATIONS=5
# Optional overrides; by default LangGraph reuses AUTOGEN_PROVIDER and AUTOGEN_MODEL.
# LANGGRAPH_PROVIDER=openai
# LANGGRAPH_MODEL=gpt-4o-mini
# LANGGRAPH_REQUEST_TIMEOUT=300
